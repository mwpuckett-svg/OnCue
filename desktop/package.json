{
  "name": "oncue-desktop",
  "productName": "OnCue",
  "version": "1.0.0",
  "description": "OnCue run-of-show, as a desktop app for Mac and Windows",
  "author": "avad3",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.avad3.oncue",
    "productName": "OnCue",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "config.json", "package.json"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "identity": null
    },
    "dmg": { "title": "OnCue" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": true, "perMachine": false },
    "artifactName": "OnCue-${version}-${os}.${ext}"
  }
}
